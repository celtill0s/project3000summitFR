# Caddy : relais devant l'appli Python (qui gère elle-même les comptes et les sessions).
# Il ne vérifie plus de mot de passe, mais protège le petit serveur Python, qui n'est pas fait
# pour être exposé seul : délais d'expiration (coupe les connexions volontairement lentes),
# taille maximale des requêtes, HTTP propre.
{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

:8080 {
	# Au-delà de la plus grosse vidéo acceptée par l'appli (500 Mo) : refusé avant même de
	# l'atteindre.
	request_body {
		max_size 520MB
	}
	reverse_proxy app:8000
}
