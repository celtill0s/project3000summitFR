<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Barres système transparentes sur fond clair (affichage bord à bord imposé depuis
             Android 15) : icônes foncées pour rester lisibles. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Écran de la carte : barre du haut verte foncée prolongée sous la barre d'état (et bande
         du bas sous la barre de navigation) → icônes système claires. -->
    <style name="AppTheme.Map">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/brand_dark</item>
    </style>
</resources>
